# 浏览器可公开配置
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 仅服务端，禁止添加 NEXT_PUBLIC_ 前缀
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 可选；Moonshot 默认 kimi-k3.1-pro，coding 地址默认 kimi-for-coding
KIMI_MODEL=
KIE_API_KEY=
SUPABASE_SECRET_KEY=

# 应用自定义配置
SUPABASE_STORAGE_BUCKET=project-assets
APP_URL=http://localhost:3000
# 允许登录的邮箱，以英文逗号分隔；留空时拒绝业务访问
APP_OWNER_EMAILS=

# 启用公网回调时填写 KIE 提供的 HMAC Key；本地轮询阶段可留空
KIE_WEBHOOK_HMAC_KEY=
# 低额度 Kimi 账户可能限制每分钟3次模型请求；服务端请求间隔（毫秒）
KIMI_REQUEST_INTERVAL_MS=21000
